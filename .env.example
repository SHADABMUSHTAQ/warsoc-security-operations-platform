# Copy to .env and replace all placeholder values before starting the API.
APP_ENV=development
JWT_SECRET_KEY=replace-with-a-new-random-secret-at-least-32-characters
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=warsoc
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:5173

# Leave third-party integrations unset unless you configure them yourself.
SUPER_ADMIN_API_KEY=
VT_API_KEY=
PRIVATE_KEY_B64=
PUBLIC_KEY_B64=
