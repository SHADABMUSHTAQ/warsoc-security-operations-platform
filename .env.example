# Copy to .env and replace all placeholder values before starting the API.
APP_ENV=development
JWT_SECRET_KEY=replace-with-a-new-random-secret-at-least-32-characters
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=WarSOC_DB
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
ENABLE_SELF_SIGNUP=false

# Leave third-party integrations unset unless you configure them yourself.
SUPER_ADMIN_API_KEY=
VT_API_KEY=
PRIVATE_KEY_B64=
PUBLIC_KEY_B64=

# Optional local-demo bootstrap values. Never use production credentials here.
DEMO_USERNAME=
DEMO_EMAIL=
DEMO_PASSWORD=
